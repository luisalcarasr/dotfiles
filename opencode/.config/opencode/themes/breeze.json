{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg0": "#232629",
    "bg1": "#2a2e32",
    "bg2": "#31363b",
    "fg0": "#eff0f1",
    "fg1": "#bdc3c7",
    "fg2": "#7f8c8d",
    "border": "#474a4f",
    "blue": "#3daee9",
    "blueBright": "#6cb8ff",
    "green": "#27ae60",
    "greenBright": "#2ecc71",
    "red": "#da4453",
    "redBright": "#e74c3c",
    "orange": "#f67400",
    "orangeBright": "#f39c12",
    "cyan": "#16a085",
    "cyanBright": "#1abc9c",
    "purple": "#9b59b6",
    "purpleBright": "#a569bd"
  },
  "theme": {
    "primary": {
      "dark": "blue",
      "light": "blue"
    },
    "secondary": {
      "dark": "fg1",
      "light": "fg1"
    },
    "accent": {
      "dark": "blueBright",
      "light": "blue"
    },
    "error": {
      "dark": "red",
      "light": "red"
    },
    "warning": {
      "dark": "orange",
      "light": "orange"
    },
    "success": {
      "dark": "green",
      "light": "green"
    },
    "info": {
      "dark": "cyan",
      "light": "cyan"
    },
    "text": {
      "dark": "fg0",
      "light": "#1f1f1f"
    },
    "textMuted": {
      "dark": "fg2",
      "light": "#5a5a5a"
    },
    "background": {
      "dark": "bg0",
      "light": "#fcfcfc"
    },
    "backgroundPanel": {
      "dark": "bg1",
      "light": "#ffffff"
    },
    "backgroundElement": {
      "dark": "bg2",
      "light": "#f0f0f0"
    },
    "border": {
      "dark": "border",
      "light": "#d3d3d3"
    },
    "borderActive": {
      "dark": "blue",
      "light": "blue"
    },
    "diffAdded": {
      "dark": "greenBright",
      "light": "green"
    },
    "diffRemoved": {
      "dark": "redBright",
      "light": "red"
    },
    "diffContext": {
      "dark": "fg2",
      "light": "fg2"
    },
    "diffHunkHeader": {
      "dark": "border",
      "light": "#d3d3d3"
    },
    "diffHighlightAdded": {
      "dark": "greenBright",
      "light": "green"
    },
    "diffHighlightRemoved": {
      "dark": "redBright",
      "light": "red"
    },
    "diffAddedBg": {
      "dark": "#1d3b25",
      "light": "#d4f0dc"
    },
    "diffRemovedBg": {
      "dark": "#4a2226",
      "light": "#f8d7da"
    },
    "diffContextBg": {
      "dark": "bg1",
      "light": "#f5f5f5"
    },
    "diffLineNumber": {
      "dark": "fg2",
      "light": "fg2"
    },
    "diffAddedLineNumberBg": {
      "dark": "#183120",
      "light": "#c3e8cd"
    },
    "diffRemovedLineNumberBg": {
      "dark": "#3e1c1f",
      "light": "#f1c6c9"
    },
    "syntaxComment": {
      "dark": "fg2",
      "light": "#7a8288"
    },
    "syntaxKeyword": {
      "dark": "purpleBright",
      "light": "purple"
    },
    "syntaxFunction": {
      "dark": "blueBright",
      "light": "blue"
    },
    "syntaxVariable": {
      "dark": "fg0",
      "light": "#1f1f1f"
    },
    "syntaxString": {
      "dark": "green",
      "light": "green"
    },
    "syntaxNumber": {
      "dark": "orange",
      "light": "orange"
    },
    "syntaxType": {
      "dark": "cyan",
      "light": "cyan"
    },
    "syntaxOperator": {
      "dark": "fg1",
      "light": "#4d4d4d"
    },
    "syntaxPunctuation": {
      "dark": "fg1",
      "light": "#4d4d4d"
    },
    "markdownText": {
      "dark": "fg0",
      "light": "#1f1f1f"
    },
    "markdownHeading": {
      "dark": "blueBright",
      "light": "blue"
    },
    "markdownLink": {
      "dark": "cyan",
      "light": "cyan"
    },
    "markdownLinkText": {
      "dark": "blue",
      "light": "blue"
    },
    "markdownCode": {
      "dark": "green",
      "light": "green"
    },
    "markdownBlockQuote": {
      "dark": "orange",
      "light": "orange"
    },
    "markdownEmph": {
      "dark": "fg0",
      "light": "#1f1f1f"
    },
    "markdownStrong": {
      "dark": "fg0",
      "light": "#1f1f1f"
    },
    "markdownHorizontalRule": {
      "dark": "border",
      "light": "#d3d3d3"
    },
    "markdownListItem": {
      "dark": "blueBright",
      "light": "blue"
    },
    "markdownListEnumeration": {
      "dark": "cyan",
      "light": "cyan"
    },
    "markdownImage": {
      "dark": "purpleBright",
      "light": "purple"
    },
    "markdownImageText": {
      "dark": "cyan",
      "light": "cyan"
    },
    "markdownCodeBlock": {
      "dark": "fg0",
      "light": "#1f1f1f"
    }
  }
}